# Agregué esta plantilla sin credenciales para configurar una copia del proyecto.
# Copiar como .env en el backend privado y completar los valores del entorno.
# El servidor tiene prioridad sobre este archivo; no subir el .env a GitHub.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Santiago

# Local tradicional: /asistencia. Subdominio: APP_BASE_PATH= y APP_URL=https://tu-subdominio.
# APP_URL debe incluir la ruta base cuando exista. No usar BASE_URL/BASE_PATH
# simultáneamente: son aliases antiguos que tienen prioridad.
APP_BASE_PATH=/asistencia
APP_URL=http://localhost/asistencia

DB_HOST=localhost
DB_PORT=3306
DB_NAME=asistencia
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP desactivado hasta completar host, remitente y credenciales.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ePracticas RRHH"
MAIL_DEBUG=0

# Comprobante por correo de cada marca de asistencia. ACTIVO=0 lo apaga.
# LOGO es relativo a public/ (vacío = sin imagen). MENSAJE vacío usa el texto por defecto.
MAIL_COMPROBANTE_ACTIVO=1
#MAIL_COMPROBANTE_MENSAJE=
MAIL_COMPROBANTE_LOGO=assets/brand/logo_correo.png

# Local con Docker: MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_ENCRYPTION=none (ver http://localhost:8025).

# public/backend.php encuentra el backend por ubicación relativa: padre de
# public en local, o ../../backend-rrhh en Hostinger. Si se usa otra estructura,
# BACKEND_PATH debe configurarse en el proceso/servidor antes de cargar el .env.
