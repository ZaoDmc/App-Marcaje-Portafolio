{
    "name": "epracticas/platform",
    "description": "Sistema de Gestion de Practicantes y Control de Asistencia",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:config": "@php tests/configuration.php",
        "test:routing": "@php tests/routing.php",
        "test:business": "@php tests/business.php",
        "test:mvc": "@php tests/mvc.php",
        "test:legacy": "@php tests/legacy-removal.php"
    }
}
